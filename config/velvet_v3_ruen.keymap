#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/modifiers.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 41 42 43 44 45>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        spc_lt: space_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        ru_space: ru_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&layer_ru>;
            mods = <(MOD_LGUI)>;
        };

        en_space: en_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPACE>, <&layer_en>;
            mods = <(MOD_LGUI)>;
        };

        spc_ru_ht: space_ru_holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <1>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&ru_space>;
        };

        spc_en_ht: space_en_holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <1>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&en_space>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <3 4>;
            layers = <1>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <3 4>;
            layers = <0>;
        };

        cmblock {
            bindings = <&kp LG(LC(Q))>;
            key-positions = <14 15 16>;
            timeout-ms = <50>;
            layers = <0 1>;
        };

        cmbgame {
            bindings = <&tog 7>;
            key-positions = <26 27 28>;
            layers = <0 1 7>;
            timeout-ms = <50>;
        };

        cmbwow {
            bindings = <&tog 10>;
            key-positions = <30 31 32>;
            layers = <0 1 10>;
            timeout-ms = <50>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC         &kp Q        &kp W        &kp E         &kp R             &kp T                              &kp Y  &kp U         &kp I         &kp O        &kp P           &kp BSPC
&hml GLOBE TAB  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F      &kp G                              &kp H  &hmr RSHFT J  &hmr RCTRL K  &hmr LALT L  &hmr RGUI SEMI  &kp BSLH
&kp LSHFT       &kp Z        &kp X        &kp C         &kp V             &kp B                              &kp N  &kp M         &kp COMMA     &kp DOT      &kp SQT         &kp RSHFT
                             &kp GRAVE    &kp LGUI      &kp LEFT_CONTROL  &mo 2  &spc_ru_ht 6    &kp RET  &mo 3  &kp LALT      &kp LBKT      &kp RBKT
            >;

            display-name = "Base";
        };

        ru {
            display-name = "Ru";
            bindings = <
&kp ESC    &kp RU_CYRILLIC_SHORT_I   &kp RU_CYRILLIC_TSE         &kp RU_CYRILLIC_U          &kp RU_CYRILLIC_KA        &kp RU_CYRILLIC_IE                              &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA        &kp RU_CYRILLIC_SHCHA      &kp RU_CYRILLIC_ZE         &kp BSPC
&kp TAB    &hml LGUI RU_CYRILLIC_EF  &hml LALT RU_CYRILLIC_YERU  &hml LCTRL RU_CYRILLIC_VE  &hml LSHFT RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                              &kp RU_CYRILLIC_ER  &hmr RSHFT RU_CYRILLIC_O   &hmr RCTRL RU_CYRILLIC_EL  &hmr LALT RU_CYRILLIC_DE   &hmr RGUI RU_CYRILLIC_ZHE  &kp BSLH
&kp LSHFT  &kp RU_CYRILLIC_YA        &kp RU_CYRILLIC_CHE         &kp RU_CYRILLIC_ES         &kp RU_CYRILLIC_EM        &kp RU_CYRILLIC_I                               &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU         &kp RU_CYRILLIC_E          &kp RSHFT
                                     &kp RU_CYRILLIC_IO          &kp LGUI                   &kp LCTRL                 &mo 2               &spc_en_ht 6    &kp RET  &mo 4               &kp LALT                   &kp RU_CYRILLIC_HA         &kp RU_CYRILLIC_HARD_SIGN
            >;
        };

        nav {
            bindings = <
&trans  &kp N1        &kp N2         &kp N3     &kp N4     &kp N5                     &kp N6    &kp N7    &kp N8        &kp N9       &kp N0  &trans
&trans  &kp LC(LEFT)  &kp LC(RIGHT)  &kp PG_DN  &kp PG_UP  &kp RET                    &kp LEFT  &kp DOWN  &kp UP        &kp RIGHT    &trans  &trans
&trans  &trans        &kp HOME       &kp INS    &kp END    &kp DEL                    &kp HOME  &kp END   &kp LC(HOME)  &kp LC(END)  &trans  &trans
                      &trans         &trans     &trans     &trans   &trans    &trans  &mo 5     &trans    &trans        &trans
            >;

            display-name = "nav";
            label = "Navigation";
        };

        sym_en {
            bindings = <
&trans  &kp HASH   &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                    &kp CARET  &kp DQT   &kp UNDER  &kp SQT   &trans    &trans
&trans  &kp BSLH   &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &kp QUESTION
&trans  &kp COMMA  &kp STAR  &kp COLON  &kp FSLH  &kp DLLR                     &kp AT     &kp PIPE  &kp TILDE  &kp AMPS  &kp DOT   &trans
                   &trans    &trans     &trans    &mo 5      &trans    &trans  &trans     &trans    &kp LBKT   &kp RBKT
            >;

            display-name = "Symbols";
        };

        sym_ru {
            display-name = "Sym ru";
            bindings = <
&trans         &en HASH          &en LT    &kp EQUAL     &en GT       &en GRAVE                    &en CARET  &kp RU_DQT  &kp UNDER    &en SQT   &trans      &trans
&kp RU_NUMERO  &kp RU_BACKSLASH  &kp LPAR  &kp MINUS     &kp RPAR     &kp PLUS                     &kp PRCNT  &en LBRC    &kp RU_SEMI  &kp RBRC  &kp EXCL    &kp RU_QMARK
&trans         &kp RU_COMMA      &kp STAR  &kp RU_COLON  &kp RU_FSLH  &en DLLR                     &en AT     &en PIPE    &en TILDE    &en AMPS  &kp RU_DOT  &trans
                                 &trans    &trans        &trans       &mo 5      &trans    &trans  &trans     &trans      &en LBKT     &en RBKT
            >;
        };

        adj {
            bindings = <
&bootloader  &none  &kp F1  &kp F2   &kp F3   &kp F4                   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none        &none  &kp F5  &kp F6   &kp F7   &kp F8                   &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &none         &studio_unlock
&none        &none  &kp F9  &kp F10  &kp F11  &kp F12                  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &none         &none
                    &none   &none    &none    &none    &none    &none  &none         &none         &none             &none
            >;

            display-name = "Adjust";
        };

        aero {
            bindings = <
&kp ESC  &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)     &kp LA(N5)                              &kp LA(N6)  &kp LA(N7)     &kp LA(N8)     &kp LA(N9)  &trans            &trans
&trans   &trans      &trans      &kp LCTRL   &kp LSHFT      &trans                                  &kp LA(H)   &kp LA(J)      &kp LA(K)      &kp LA(L)   &kp LA(LS(SEMI))  &trans
&trans   &trans      &trans      &kp LA(C)   &kp LA(COMMA)  &kp LA(FSLH)                            &trans      &kp LA(MINUS)  &kp LA(EQUAL)  &trans      &trans            &trans
                     &trans      &trans      &trans         &trans        &none    &kp LA(LS(TAB))  &trans      &trans         &trans         &trans
            >;

            display-name = "Aero";
            label = "Aerospace";
        };

        game {
            bindings = <
&kp ESC   &kp TAB    &kp Q     &kp W  &kp E        &kp R                       &trans  &trans  &trans  &trans  &trans  &trans
&kp LGUI  &kp LSHFT  &kp A     &kp S  &kp D        &kp F                       &trans  &trans  &trans  &trans  &trans  &trans
&kp LALT  &kp LCTRL  &kp Z     &kp X  &kp C        &kp V                       &trans  &trans  &trans  &trans  &trans  &trans
                     &kp LALT  &kp G  &lt 9 LCTRL  &mo 8  &kp SPACE    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "Game";
        };

        game_num {
            bindings = <
&trans  &trans  &kp N7  &kp N8  &kp N9  &kp N0                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N4  &kp N5  &kp N6  &kp ENTER                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans     &trans    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "GameNum";
        };

        game_right {
            bindings = <
&kp P     &kp O    &kp I      &kp U     &kp Y   &kp T                      &trans  &trans  &trans  &trans  &trans  &trans
&kp SEMI  &kp L    &kp K      &kp J     &kp H   &kp G                      &trans  &trans  &trans  &trans  &trans  &trans
&kp SQT   &kp DOT  &kp COMMA  &kp M     &kp N   &kp B                      &trans  &trans  &trans  &trans  &trans  &trans
                   &kp RBKT   &kp LBKT  &trans  &trans  &kp RET    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "GameR";
        };

        wow {
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3  &kp N4     &kp N5                       &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp Q   &kp W     &kp E   &kp R      &kp T                        &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp A   &kp S     &kp D   &kp F      &kp G                        &trans  &trans  &trans  &trans  &trans  &trans
                   &kp LALT  &none   &kp LCTRL  &mo 11  &kp SPACE    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "WoW";
        };

        wow_num {
            bindings = <
&kp GRAVE  &kp N6  &kp N7    &kp N8  &kp N9     &kp N0                       &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB    &kp Z   &kp X     &kp C   &kp V      &kp B                        &trans  &trans  &trans  &trans  &trans  &trans
&kp LSHFT  &kp Y   &kp H     &kp J   &kp N      &kp M                        &trans  &trans  &trans  &trans  &trans  &trans
                   &kp LALT  &none   &kp LCTRL  &trans  &kp SPACE    &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "WoW Num";
        };
    };
};
